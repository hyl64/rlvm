<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist SYSTEM "file://localhost/System/Library/DTDs/PropertyList.dtd">
<plist version="0.9">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>rlvm</string>
  <key>CFBundleIdentifier</key>
  <string>org.elliotglaysher.rlvm</string>
	<key>CFBundleIconFile</key>
	<string>rlvm.icns</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>rlvm</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.14</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- Without this, macOS pixel-doubles the whole window on Retina
	     displays and the renderer never sees a sharp surface. -->
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSMainNibFile</key>
	<string>SDLMain.nib</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © 2006-2013 Elliot Glaysher, Haeleth, Jagarl, et all.</string>
</dict>
</plist>
